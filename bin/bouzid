#!/usr/bin/env bash
# Bouzid FM 2.0 — management & control CLI (Google-only, AzuraCast backend)
set -euo pipefail

# Resolve repo root (this script lives in <root>/bin). The CLI is installed as
# a SYMLINK in /usr/local/bin, so we must follow symlinks to find the real repo
# (otherwise scripts/ resolves under /usr/local). BOUZID_HOME overrides it all.
if [ -n "${BOUZID_HOME:-}" ] && [ -d "${BOUZID_HOME}/scripts" ]; then
  ROOT="$BOUZID_HOME"
else
  SOURCE="${BASH_SOURCE[0]}"
  while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE";; esac
  done
  SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
cd "$ROOT"

[ -f .env ] && set -a && . ./.env && set +a
DC="docker compose"

# Music library lives OUTSIDE the app folder so reinstalls never wipe it.
MUSIC_DIR="${MUSIC_DIR:-$HOME/bouzid-music}"

c_blue()  { printf '\033[1;34m%s\033[0m\n' "$*"; }
c_green() { printf '\033[1;32m%s\033[0m\n' "$*"; }
c_red()   { printf '\033[1;31m%s\033[0m\n' "$*"; }

usage() {
  cat <<EOF
Bouzid FM 2.0 — a fully automated AI Tunisian radio station
          Google-only, TUI-first, AzuraCast backend

Usage: bouzid <command> [options]

—————————————————————————— Stack ——————————————————————————
  start                  Start the Docker stack (AzuraCast)
                           $ bouzid start
  stop                   Stop the stack
                           $ bouzid stop
  restart                Restart the stack
  status                 Show container status
                           $ bouzid status
  logs [service]         Tail logs (default: all)
                           $ bouzid logs azuracast
  health                 Check that all services respond
                           $ bouzid health

—————————————————————————— Content —————————————————————————
  show <slug> [opts]     Generate any preset show by slug
                           $ bouzid show news --upload
                           $ bouzid show cook --air
                           $ bouzid show farmer --play
                           $ bouzid show news --upload
                           $ bouzid show cook --script-only
  shows                  List all preset shows
                           $ bouzid shows
  mix [opts]             Mix a voice file with intro/bed/outro
                           $ bouzid mix voice.mp3 --play
  breaking [text]        Write an URGENT bulletin and air it NOW
                           $ bouzid breaking                      # latest headlines
                           $ bouzid breaking "خبر عاجل: …"        # custom text
  play-now <file|path>   Air any audio clip immediately
                           $ bouzid play-now bulletin.mp3
                           $ bouzid play-now "News/bulletin.mp3"
  push-news <file>       Upload a bulletin MP3 to the station
                           $ bouzid push-news bulletin.mp3

  Options for show:
    --play               Play locally after generation
    --upload             Upload to AzuraCast (appears in schedule)
    --air                Upload + cut to live broadcast NOW
    --script-only        Just write the script, skip TTS (fast & cheap)
    --no-mix             Skip intro/bed/outro mixing
    --text "…"           Use custom text instead of generated content

—————————————————————————— Music ———————————————————————————
  fetch [opts]           Download trending Tunisian music from Anghami
                           $ bouzid fetch                         # all categories
                           $ bouzid fetch --crate morning
                           $ bouzid fetch --list                  # show plan
                           $ bouzid fetch --bg                    # background
  fetch-status [--watch] Show download progress
                           $ bouzid fetch-status --watch
  rescan                 Import library into AzuraCast + apply schedule
                           $ bouzid rescan
  music-reset [--dry-run] Make AzuraCast match your local files
                           $ bouzid music-reset --dry-run         # preview only
  flush [--dry-run]      Wipe ALL AzuraCast media + Bouzid playlists
                           $ bouzid flush --dry-run

—————————————————————————— Imaging & Jingles ———————————————
  imaging [opts]         Generate station imaging (intro/outro/bed/sting)
    --show <slug>        Target a specific show
    --kind <kind>        One of: intro outro bed transition sting
    --replace            Drop old variants for this scope first
    --make-default       Pin the new variant as the default
    --voice <name>       Gemini voice override
    --list               List what would be generated (dry info)
                           $ bouzid imaging --show cook --kind intro
                           $ bouzid imaging --kind sting --replace
                           $ bouzid imaging --list
  assets <sub>           Manage imaging variants & pinned defaults
                           $ bouzid assets overview
                           $ bouzid assets list cook intro
                           $ bouzid assets set-default cook intro file.mp3
                           $ bouzid assets clear-default cook intro
  use-jingle <file>      Promote a jingle to a show role
    --for <show>           $ bouzid use-jingle id_x.mp3 --for cook --as intro
    --as <role>            $ bouzid use-jingle --latest --for station --as bed
    --latest               $ bouzid use-jingle --list
    --list                  (role: intro|outro|bed|transition|sting)

—————————————————————————— Studio (TUI) ——————————————————————
  tui                    Open the full control panel
                           $ bouzid tui

—————————————————————————— Schedule ————————————————————————
  schedule [opts]        Apply the weekly grid as AzuraCast playlists
                           $ bouzid schedule                     # apply
                           $ bouzid schedule --dry-run           # preview
                           $ bouzid schedule --reset             # clear + re-apply
  grid                   Print the weekly programming grid
                           $ bouzid grid

—————————————————————————— Live Broadcast ——————————————————
  now                    Show what's currently playing
                            $ bouzid now
  skip                   Skip the current track
                            $ bouzid skip
  previous [--back N]    Replay a previous track
                            $ bouzid previous                     # last track
                            $ bouzid previous --back 2            # 2 tracks ago

—————————————————————————— Scheduler ————————————————————————
  scheduler [start]      Start auto-show generation (background daemon)
                            $ bouzid scheduler
                            $ bouzid scheduler start
  scheduler stop         Stop the scheduler daemon
                            $ bouzid scheduler stop
  scheduler status       Check if the scheduler is running
                            $ bouzid scheduler status
  scheduler once         Run one generation pass and exit
                            $ bouzid scheduler once

—————————————————————————— Voice ———————————————————————————
  say [text]             Test the current Gemini voice
                           $ bouzid say "مرحبا بكم"
                           $ bouzid say                          # default sample
  voices                 List all available Gemini voices
                           $ bouzid voices

—————————————————————————— Info & Maintenance ———————————————
  stream-url             Print the public stream URL
  urls                   Print all admin URLs
  music-dir              Print the music library path
  sync [show]            Two-way sync episodes with AzuraCast
                           $ bouzid sync all
                           $ bouzid sync cook
  reset-assets           Wipe assets/ & rebuild, then rescan
                           $ bouzid reset-assets
  uninstall              Remove containers + volumes (keeps music)
                           $ bouzid uninstall
                           $ bouzid uninstall --purge-music      # also delete music
  help / -h / --help     Show this help

—————————————————————————— Quick start ——————————————————————
  1. bouzid start                  # boot AzuraCast
  2. bouzid health                 # wait until OK
  3. bouzid say "مرحبا"            # test your Gemini voice
   4. bouzid show news --upload     # generate + upload a bulletin
  5. bouzid tui                    # full control panel
  6. bouzid schedule               # apply weekly programming
EOF
}

# Ensure an AzuraCast API key is configured before hitting the API.
ensure_api() {
  if [ -z "${AZURACAST_API_KEY:-}" ]; then
    c_red "AZURACAST_API_KEY is empty."
    c_blue "Open http://localhost > My Account > API Keys, create a key, then"
    c_blue "put it in .env as AZURACAST_API_KEY=... and re-run this command."
    exit 1
  fi
}

# Ensure the Google Gemini key is present before any TTS / writing.
ensure_gemini() {
  if [ -z "${GEMINI_API_KEY:-}" ]; then
    c_red "GEMINI_API_KEY is empty."
    c_blue "Get a free key: https://aistudio.google.com/apikey"
    c_blue "Then put it in .env as GEMINI_API_KEY=... and re-run."
    exit 1
  fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  start)    c_blue "Starting Bouzid FM ..."; $DC up -d; c_green "Up. Try: bouzid health";;
  stop)     $DC down;;
  restart)  $DC restart;;
  status)   $DC ps;;
  logs)     $DC logs -f --tail=120 ${1:+"$1"};;
  health)
    ok=0
    checks="${AZURACAST_HTTP_PORT:-80}:AzuraCast"
    for p in $checks; do
      port="${p%%:*}"; name="${p##*:}"
      if curl -fsS -o /dev/null --max-time 4 "http://localhost:${port}"; then
        c_green "  OK   ${name} (:${port})"
      else
        c_red   "  DOWN ${name} (:${port})"; ok=1
      fi
    done
    exit $ok;;
  say|tts-test)
    ensure_gemini
    txt="${*:-مستمعي بوزيد إف إم، هذه تجربة صوت.}"
    python3 scripts/tts_engine.py --text "$txt" --out /tmp/bouzid_tts.mp3 \
      && c_green "Wrote /tmp/bouzid_tts.mp3 (play it to preview the Gemini voice ${GEMINI_TTS_VOICE:-Kore}).";;
  voices|list-voices)
    python3 scripts/tts_engine.py --list-voices;;
  fetch)
    bg=0; rest=()
    for a in "$@"; do
      case "$a" in
        --bg|--background) bg=1;;
        *) rest+=("$a");;
      esac
    done
    # Default to every crate when no scope/sub-command is given.
    scope=0
    for a in ${rest[@]+"${rest[@]}"}; do
      case "$a" in
        --all|--crate|--list|--get|--set|--reset|--clear|--url|-f|--file) scope=1;;
      esac
    done
    [ "$scope" = 0 ] && rest=(--all ${rest[@]+"${rest[@]}"})
    if [ "$bg" = 1 ]; then
      mkdir -p data
      nohup python3 scripts/anghami_dl.py --quiet ${rest[@]+"${rest[@]}"} > data/initial-fetch.log 2>&1 &
      pid=$!
      c_green "Music download started in the background (PID ${pid})."
      c_blue  "  Check progress:  bouzid fetch-status"
      c_blue  "  Full log:        tail -f ${ROOT}/data/initial-fetch.log"
    else
      python3 scripts/anghami_dl.py ${rest[@]+"${rest[@]}"}
    fi;;
  fetch-status|progress)
    python3 scripts/fetch_status.py "$@";;
  rescan)
    ensure_api
    c_blue "Importing music from ${MUSIC_DIR} into AzuraCast ..."
    python3 scripts/azuracast.py import --dir "${MUSIC_DIR}" || { c_red "import failed"; exit 1; }
    c_blue "Applying the weekly schedule (reset) ..."
    python3 scripts/azuracast.py apply-schedule --reset || c_red "schedule failed"
    c_blue "Restarting broadcasting so changes go live ..."
    python3 scripts/azuracast.py restart >/dev/null 2>&1 || true
    c_green "Done. Check it with: bouzid now";;
  music-reset|reset-music)
    ensure_api
    python3 scripts/music_reset.py "$@";;
  flush|wipe)
    ensure_api
    python3 scripts/azuracast.py flush "$@";;
  scheduler)
    sub="${1:-start}"; shift || true
    pid_file="${ROOT}/data/scheduler.pid"
    import_script="scripts/scheduler.py"
    case "$sub" in
      start|"")
        mkdir -p data
        if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
          c_blue "Scheduler is already running (PID $(cat "$pid_file"))."
        else
          rm -f "$pid_file"
          nohup python3 "$import_script" > data/scheduler.log 2>&1 &
          pid=$!
          echo "$pid" > "$pid_file"
          c_green "Scheduler started (PID $pid)."
          c_blue "  Logs: tail -f ${ROOT}/data/scheduler.log"
        fi;;
      stop)
        if [ -f "$pid_file" ]; then
          pid=$(cat "$pid_file")
          kill "$pid" 2>/dev/null && c_green "Scheduler (PID $pid) stopped." \
            || c_blue "Scheduler (PID $pid) was not running."
          rm -f "$pid_file"
        else
          c_blue "No scheduler PID file found."
        fi;;
      status)
        if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
          c_green "Scheduler is running (PID $(cat "$pid_file"))."
        else
          c_blue "Scheduler is NOT running."
        fi;;
      once)
        python3 "$import_script" --once;;
      *)
        c_red "Usage: bouzid scheduler [start|stop|status|once]"
        exit 1;;
    esac;;
  tui)
    PY="python3"; [ -x "$ROOT/.venv/bin/python" ] && PY="$ROOT/.venv/bin/python"
    exec "$PY" scripts/bouzid_tui.py;;
  shows|list-shows) python3 scripts/show_engine.py --list;;
  show)
    slug="${1:-}"; shift || true
    if [ -z "$slug" ]; then
      c_red "Usage: bouzid show <slug> [opts]"
      c_blue "  e.g. bouzid show news --upload    bouzid show cook --air"
      echo
      python3 scripts/show_engine.py --list
      exit 1
    fi
    ensure_gemini; python3 scripts/show_engine.py --show "$slug" "$@";;
  mix)      python3 scripts/audio_mix.py "$@";;
  imaging|reimage|imaging-regen)
            case " $* " in *" --list "*|*" --dry-run "*) ;; *) ensure_gemini;; esac
            python3 scripts/make_imaging.py "$@";;
  assets)   python3 scripts/assets_lib.py "$@";;
  library|lib) python3 scripts/library.py "$@";;
  sync)
    ensure_api
    if [ $# -ge 1 ]; then python3 scripts/library.py sync "$@";
    else python3 scripts/library.py sync all; fi;;
  reset-assets)
    python3 scripts/assets_lib.py reset "$@"
    c_blue "Rescanning AzuraCast media after reset ..."
    ensure_api && python3 scripts/azuracast.py import --dir "${MUSIC_DIR}" \
      || c_red "rescan failed";;
  now)      ensure_api; python3 scripts/azuracast.py nowplaying;;
  skip)     ensure_api; python3 scripts/azuracast.py skip;;
  previous|prev)
    ensure_api; python3 scripts/azuracast.py previous "$@";;
  push-news)
    [ $# -ge 1 ] || { c_red "Usage: bouzid push-news /path/bulletin.mp3"; exit 1; }
    ensure_api; python3 scripts/azuracast.py upload "$1" --to "News/$(basename "$1")";;
  breaking|urgent)
    ensure_api; ensure_gemini
    out="/tmp/bouzid_breaking_$(date +%Y%m%d_%H%M%S).mp3"
    if [ $# -ge 1 ] && [ "${1#--}" = "$1" ]; then
      txt="$1"; shift
      c_blue "Writing URGENT bulletin from your text ..."
      python3 scripts/show_engine.py --show news --text "$txt" --out "$out" "$@" \
        || { c_red "bulletin generation failed"; exit 1; }
    else
      c_blue "Writing URGENT bulletin from the latest headlines ..."
      python3 scripts/show_engine.py --show news --out "$out" "$@" \
        || { c_red "bulletin generation failed"; exit 1; }
    fi
    dest="Breaking/$(basename "$out")"
    c_blue "Uploading and putting it on air now ..."
    python3 scripts/azuracast.py upload "$out" --to "$dest" >/dev/null \
      || { c_red "upload failed"; exit 1; }
    python3 scripts/azuracast.py play-now "$dest" \
      && c_green "ON AIR: $dest" \
      || { c_red "could not force it on air (see message above)"; exit 1; };;
  play-now|air-now)
    [ $# -ge 1 ] || { c_red "Usage: bouzid play-now <file.mp3 | AzuraCastPath>"; exit 1; }
    ensure_api
    arg="$1"; shift || true
    if [ -f "$arg" ]; then
      dest="Breaking/$(basename "$arg")"
      c_blue "Uploading $arg ..."
      python3 scripts/azuracast.py upload "$arg" --to "$dest" >/dev/null \
        || { c_red "upload failed"; exit 1; }
    else
      dest="$arg"
    fi
    python3 scripts/azuracast.py play-now "$dest" "$@" \
      && c_green "ON AIR: $dest";;
  use-jingle|jingle-as)
    python3 scripts/use_jingle.py "$@";;
  schedule)
    ensure_api; python3 scripts/azuracast.py apply-schedule "$@";;
  grid)     python3 scripts/build_grid.py >/dev/null && cat weekly_grid.md;;
  stream-url)
    echo "http://localhost:8000/radio.mp3  (exact mount shown in the AzuraCast UI)";;
  music-dir)
    echo "${MUSIC_DIR}";;
  urls)
    echo "AzuraCast : http://localhost:${AZURACAST_HTTP_PORT:-80}"
    echo "Stream    : http://localhost:8000/radio.mp3  (exact mount shown in the AzuraCast UI)"
    echo "Music dir : ${MUSIC_DIR}";;
  uninstall|reset|clean)
    purge_music=0
    for a in "$@"; do [ "$a" = "--purge-music" ] && purge_music=1; done
    c_red "This stops Bouzid FM and DELETES all containers, volumes and app data."
    if [ "$purge_music" = 1 ]; then
      c_red "--purge-music: your music library in ${MUSIC_DIR} will ALSO be deleted."
    else
      c_green "Your music library in ${MUSIC_DIR} will be KEPT (re-used on reinstall)."
    fi
    printf 'Type "yes" to continue: '; read -r ans
    [ "$ans" = "yes" ] || { c_blue "Cancelled."; exit 0; }
    c_blue "Stopping the stack and removing volumes ..."
    $DC down -v --remove-orphans 2>/dev/null || true
    c_blue "Removing app data/ ..."
    rm -rf data 2>/dev/null || sudo rm -rf data
    if [ "$purge_music" = 1 ]; then
      c_blue "Removing music library ${MUSIC_DIR} ..."
      rm -rf "${MUSIC_DIR}" 2>/dev/null || sudo rm -rf "${MUSIC_DIR}"
    fi
    c_green "Clean. To start fresh: re-run ./install.sh  (your music is reused unless purged).";;
  help|-h|--help) usage;;
  *) c_red "Unknown command: $cmd"; echo; usage; exit 1;;
esac
