# ---- Bouzid FM 2.0 environment (EXAMPLE) ----------------------------------
# Copy to .env and fill in your own values. Google-only build:
# text = Google Gemini, voice = Google Gemini TTS.

TZ=Africa/Tunis

# Pin the Docker Compose project name (do NOT change after first boot).
COMPOSE_PROJECT_NAME=bouzid-fm

# ---- Music library (PERSISTENT) -------------------------------------------
MUSIC_DIR=$HOME/bouzid-music

# ---- AzuraCast -------------------------------------------------------------
AZURACAST_URL=http://localhost
# My Account > API Keys in the AzuraCast web UI.
AZURACAST_API_KEY=your-azuracast-api-key
AZURACAST_STATION=bouzid
AZURACAST_HTTP_PORT=80
AZURACAST_HTTPS_PORT=443
AZURACAST_SFTP_PORT=2022

# ---- Google Gemini (text + speech) ----------------------------------------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Self-throttle (15 req/min recommended). DAILY_CAP=0 = unlimited.
GOOGLE_TTS_RPM=15
GOOGLE_TTS_DAILY_CAP=0

# ---- Lyria 3 music generation (imaging) ------------------------------------
# Rate limit: 3 req/min default. Lyria is heavier than TTS, so pace conservatively.
LYRIA_RPM=3
LYRIA_DAILY_CAP=0

# ---- Broadcast voice processing ("radio imaging" chain) -------------------
BOUZID_VOICE_FX=1
BOUZID_VOICE_PITCH=0.99
BOUZID_VOICE_WARMTH=1.5
BOUZID_VOICE_PRESENCE=1.5
BOUZID_VOICE_COMP=2.0
BOUZID_VOICE_EXCITE=0.6
BOUZID_VOICE_DEESS=0.2
BOUZID_NEWS_VOICE_FX=1

# ---- Daily shows ----------------------------------------------------------
# Blank = each show's default (Cook=Leda, Sidi=Kore). Or any Gemini voice.
COOK_VOICE=
SIDI_VOICE=
BOUZID_COOK_VOICE_FX=1
BOUZID_SIDI_VOICE_FX=1

# ---- News fetch ------------------------------------------------------------
FETCH_INTERVAL=6h
MAX_PER_SOURCE=15
MAX_DURATION_SEC=600

# ---- Audio mix / loudness -------------------------------------------------
# Resting music-bed level under the voice (0..1). Big-station feel: the bed
# sits loud & present, then ducks hard under the voice and swells back up.
# Raise toward 0.65 for a fuller bed, lower toward 0.35 for a subtler one.
BED_GAIN=0.5
