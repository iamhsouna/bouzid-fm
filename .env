# ---- Bouzid FM 2.0 environment (LIVE) -------------------------------------
# Google-only build: text = Google Gemini, voice = Google Gemini TTS.
# This .env holds the active config + API key. It is gitignored so the key
# is NOT committed. On the radio box the installer-generated .env is the one
# actually used.

TZ=Africa/Tunis

# Pin the Docker Compose project name so AzuraCast's database (admin account,
# station + API keys) ALWAYS lives in the same volumes and survives every code
# update / reinstall. Do NOT change after first boot.
COMPOSE_PROJECT_NAME=bouzid-fm

# ---- Music library (PERSISTENT) -------------------------------------------
# Lives OUTSIDE the app folder. Set by the installer; default below.
MUSIC_DIR=$HOME/bouzid-music

# ---- AzuraCast -------------------------------------------------------------
AZURACAST_URL=http://localhost
AZURACAST_API_KEY=f9cf1ebc9e90e511:55b5f72fe1c735eabc20c0270d65a453
AZURACAST_STATION=bouzid
AZURACAST_HTTP_PORT=80
AZURACAST_HTTPS_PORT=443
AZURACAST_SFTP_PORT=2022

# ---- n8n -------------------------------------------------------------------
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=bouzid2026

# ---- Google Gemini (text + speech) ----------------------------------------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6Il2B-Y7UnZPKDB7u_WfUwJ1jh3qi9n3DwZEHtOaF6IPQ
# Text generation (news + show writer) — Google's latest GA Flash model
GEMINI_TEXT_MODEL=gemini-3.5-flash
# Speech synthesis (the station voice)
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Self-throttle so the free tier never gets rate-limited / banned.
# 15 req/min is the recommended steady pace. DAILY_CAP=0 = unlimited.
GOOGLE_TTS_RPM=15
GOOGLE_TTS_DAILY_CAP=0

# ---- Broadcast voice processing ("radio imaging" chain) -------------------
BOUZID_VOICE_FX=1
BOUZID_VOICE_PITCH=0.99
BOUZID_VOICE_WARMTH=1.5
BOUZID_VOICE_PRESENCE=1.5
BOUZID_VOICE_COMP=2.0
BOUZID_VOICE_EXCITE=0.6
BOUZID_VOICE_DEESS=0.2
BOUZID_NEWS_VOICE_FX=1

# ---- Daily shows ----------------------------------------------------------
# "Cook with Eya" (كوك مع إيّة) and "Story of Sidi Bouzid" (حكاية سيدي بوزيد).
# Leave the voice blank to use each show's default (Cook=Leda, Sidi=Kore),
# or set any Gemini voice name (see: bouzid voices).
COOK_VOICE=
SIDI_VOICE=
BOUZID_COOK_VOICE_FX=1
BOUZID_SIDI_VOICE_FX=1

# ---- News fetch ------------------------------------------------------------
FETCH_INTERVAL=6h
MAX_PER_SOURCE=15
MAX_DURATION_SEC=600

# ---- Audio mix / loudness -------------------------------------------------
# Resting music-bed level under the voice (0..1). Raise for a fuller bed,
# lower for a subtler one. The bed ducks hard under the voice automatically.
BED_GAIN=0.5
